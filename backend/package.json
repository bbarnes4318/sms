{
  "name": "sms-gateway-backend",
  "version": "1.0.0",
  "description": "SMS Gateway Backend for Bulkvs and SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "node --check server.js && node --check database.js && node --check queue.js && node --check public/lib/classification.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
